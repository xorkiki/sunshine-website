---
import Base from '../layouts/Base.astro';
import { sanityClient } from '../lib/sanity';

let projects: any[] = [];
try {
  projects = await sanityClient.fetch(`
    *[_type == "portfolioItem" && "featured" in category] | order(_createdAt desc) {
      _id, title, description, "slug": slug.current,
      "coverUrl": coverImage.asset->url,
      "images": images[].asset->url
    }
  `);
  console.log('[index] Sanity returned', projects.length, 'items');
} catch (e: any) {
  console.error('[index] Sanity fetch failed:', e?.message);
}

const projectsJson = JSON.stringify(projects);
---

<Base title="Home" description="Sunzhique — Fashion Stylist & Creative Director" hideNavLinks={true}>
<div id="root" data-state="default">

  <!-- LEFT (empty column for grid spacing) -->
  <div id="left"></div>

  <!-- IMAGE COLUMN (becomes thumbnail strip in detail state) -->
  <div id="img-col">
    {projects.map((p, i) => (
      <div
        class="proj-item"
        data-index={String(i)}
        data-title={p.title}
        data-credits={p.credits || 'Photography: Sunzhique'}
        data-desc={p.description || ''}
      >
        <img src={p.coverUrl} alt={p.title} loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
      </div>
    ))}
  </div>

  <!-- RIGHT: hover text or selected image -->
  <div id="right">
    <div id="hover-text">
      <p id="ht-title"></p>
      <p id="ht-credits"></p>
      <p id="ht-desc"></p>
    </div>
    <img id="selected-img" src="" alt="" />
    <button id="close-btn">Close</button>
  </div>

</div>

<nav id="home-nav">
  <a href="/styling" class="home-nav-link">Styling</a>
  <a href="/photography" class="home-nav-link">Photography</a>
  <a href="/about" class="home-nav-link">About</a>
</nav>

</Base>

<script define:vars={{ projectsJson }}>
const projects = JSON.parse(projectsJson);

const root        = document.getElementById('root');
const imgCol      = document.getElementById('img-col');
const right       = document.getElementById('right');
const hoverText   = document.getElementById('hover-text');
const selectedImg = document.getElementById('selected-img');
const closeBtn    = document.getElementById('close-btn');
const htTitle     = document.getElementById('ht-title');
const htCredits   = document.getElementById('ht-credits');
const htDesc      = document.getElementById('ht-desc');
const navLinks    = document.querySelector('.nav-links');
const homeNav     = document.getElementById('home-nav');

let active = null;

// ── HOVER (default state only) ─────────────────────────
let hoveredItem   = null;
let hoverTimeout  = null;
let lastItemScrollAdj = 0;
let lastItemPrevSib   = null;

// Reset state on page load/navigation
function resetState() {
  active = null;
  hoveredItem = null;
  if (hoverTimeout) { clearTimeout(hoverTimeout); hoverTimeout = null; }
  lastItemScrollAdj = 0;
  lastItemPrevSib = null;
  if (root) root.dataset.state = 'default';
  if (hoverText) {
    hoverText.classList.remove('visible');
    hoverText.style.top = '';
    hoverText.style.left = '';
  }
  if (imgCol) {
    imgCol.querySelectorAll('.proj-item').forEach(item => {
      item.classList.remove('is-hovered', 'is-selected');
    });
  }
  if (navLinks) {
    navLinks.style.opacity = '';
    navLinks.style.pointerEvents = '';
  }
  if (homeNav) homeNav.style.display = '';
}

function clearHover() {
  if (hoverTimeout) { clearTimeout(hoverTimeout); hoverTimeout = null; }
  if (hoveredItem) {
    hoveredItem.classList.remove('is-hovered');
    if (lastItemPrevSib) { lastItemPrevSib.style.paddingBottom = ''; lastItemPrevSib = null; }
    if (lastItemScrollAdj !== 0) {
      const adj = lastItemScrollAdj;
      lastItemScrollAdj = 0;
      requestAnimationFrame(() => {
        imgCol.style.transition = 'transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
        scrollOffset -= adj;
        applyScroll();
        setTimeout(() => { imgCol.style.transition = ''; imgCol.style.paddingBottom = ''; }, 360);
      });
    }
    hoveredItem = null;
  }
  hoverText.classList.remove('visible');
  hoverText.style.top = '';
  hoverText.style.left = '';
  // Clear text content to prevent stale text from appearing at (0,0) if a timeout executes
  htTitle.textContent = '';
  htCredits.textContent = '';
  htDesc.textContent = '';
}

imgCol.addEventListener('mouseover', e => {
  if (root.dataset.state !== 'default') return;
  const item = e.target.closest('.proj-item');
  if (!item) { clearHover(); return; }
  if (item === hoveredItem) return;

  clearHover();

  const isLast = !item.nextElementSibling;

  if (isLast) {
    // ── Last item special case ──────────────────────────
    // padding-top pushes the image DOWN, which is wrong for the last item.
    // Instead: grow the previous sibling (creates gap above) and use only
    // padding-bottom on the last item (image stays put, space below for scale).
    // Then scroll the whole column up so the image bounces upward.
    const imgEl = item.querySelector('img');
    const rect  = imgEl.getBoundingClientRect(); // measure before any change

    const prevSib = item.previousElementSibling;
    if (prevSib) { prevSib.style.paddingBottom = '80px'; lastItemPrevSib = prevSib; }

    hoveredItem = item;
    item.classList.add('is-hovered'); // CSS gives padding: 0 0 80px 0 for :last-child

    // Image will be pushed DOWN 80px by prevSib growing.
    // We scroll UP enough to bring it back above that + clear scale overflow.
    const futureBottom = rect.bottom + 80 + rect.height * 0.15;
    const scrollNeeded = Math.max(0, Math.ceil(futureBottom - (window.innerHeight - 32)));
    if (scrollNeeded > 0) {
      lastItemScrollAdj = scrollNeeded;
      imgCol.style.paddingBottom = scrollNeeded + 'px'; // grow scrollHeight so max allows it
      requestAnimationFrame(() => {
        imgCol.style.transition = 'transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
        scrollOffset += scrollNeeded;
        applyScroll();
        setTimeout(() => { imgCol.style.transition = ''; }, 360);
      });
    }
  } else {
    hoveredItem = item;
    item.classList.add('is-hovered');
  }

  // Wait for padding transition to finish before positioning hover text
  // Set text content inside timeout to ensure it's only set when we're actually showing it
  hoverTimeout = setTimeout(() => {
    if (hoveredItem !== item) return;
    
    // Set text content only when we're about to show it
    htTitle.textContent   = item.dataset.title;
    htCredits.textContent = item.dataset.credits;
    htDesc.textContent    = item.dataset.desc;
    const imgEl    = item.querySelector('img');
    const imgRect  = imgEl.getBoundingClientRect();
    const textH    = hoverText.offsetHeight;
    const viewportHeight = window.innerHeight;
    
    // Check if text would go off screen if positioned below
    const spaceBelow = viewportHeight - imgRect.bottom;
    const spaceAbove = imgRect.top;
    const textNeeds = textH + 5; // text height + spacing
    
    let topPosition;
    if (spaceBelow >= textNeeds) {
      // Enough space below - position below image
      topPosition = imgRect.bottom + 5;
    } else if (spaceAbove >= textNeeds) {
      // Not enough space below, but enough above - position above image
      topPosition = imgRect.top - textH - 5;
    } else {
      // Not enough space either way - position below but let it be visible
      topPosition = imgRect.bottom + 5;
    }
    
    // Double-check that hoveredItem still matches before setting position
    if (hoveredItem !== item) return;
    
    hoverText.style.top  = topPosition + 'px';
    hoverText.style.left = imgRect.left + 'px';
    
    // Verify position was set correctly before making visible
    // Use requestAnimationFrame to ensure position is applied before adding visible class
    requestAnimationFrame(() => {
      // Final guard check - ensure we're still hovering the same item
      if (hoveredItem !== item) return;
      
      // Verify position is actually set (not empty string which would fall back to CSS default 0,0)
      // If clearHover() was called, it would have cleared these styles, making them empty strings
      const currentLeft = hoverText.style.left;
      const currentTop = hoverText.style.top;
      if (currentLeft && currentTop) {
        hoverText.classList.add('visible');
      }
    });
    hoverTimeout = null;
  }, 300);
});

imgCol.addEventListener('mouseleave', clearHover);

// ── CLICK ──────────────────────────────────────────────
imgCol.addEventListener('click', e => {
  const item = e.target.closest('.proj-item');
  if (!item) return;

  const pi = parseInt(item.dataset.index);
  const project = projects[pi];

  if (root.dataset.state === 'detail') {
    imgCol.querySelectorAll('.proj-item').forEach(t => t.classList.remove('is-selected'));
    item.classList.add('is-selected');
    selectedImg.src = project.coverUrl;
    selectedImg.alt = project.title;
    return;
  }

  clearHover();
  imgCol.querySelectorAll('.proj-item').forEach(t => t.classList.remove('is-selected'));
  item.classList.add('is-selected');

  selectedImg.src = project.coverUrl;
  selectedImg.alt = project.title;

  active = { project };
  root.dataset.state = 'detail';
  if (navLinks) { navLinks.style.opacity = '0'; navLinks.style.pointerEvents = 'none'; }
  homeNav.style.display = 'none';
  // Reset close button styles so CSS can control it
  if (closeBtn) {
    closeBtn.style.display = '';
    closeBtn.style.opacity = '';
    closeBtn.style.pointerEvents = '';
  }
});

// ── CLOSE ──────────────────────────────────────────────
function closeDetail() {
  imgCol.querySelectorAll('.proj-item').forEach(t => t.classList.remove('is-selected'));
  active = null;
  // Immediately hide close button to prevent overlap
  if (closeBtn) {
    closeBtn.style.opacity = '0';
    closeBtn.style.pointerEvents = 'none';
    closeBtn.style.display = 'none';
  }
  root.dataset.state = 'closing';
  if (navLinks) { navLinks.style.opacity = ''; navLinks.style.pointerEvents = ''; }
  homeNav.style.display = '';
  setTimeout(() => { root.dataset.state = 'default'; }, 50);
}

closeBtn.addEventListener('click', closeDetail);

// Custom scroll — replaces overflow-y:auto so img-col can be overflow:visible
let scrollOffset = 56;
function applyScroll() {
  const max = imgCol.scrollHeight - window.innerHeight;
  scrollOffset = Math.max(0, Math.min(max, scrollOffset));
  imgCol.style.transform = `translateY(-${scrollOffset}px)`;
}
applyScroll();

// Initialize/reset on page load
resetState();

// Reset on Astro view transition (when navigating back to page)
document.addEventListener('astro:page-load', () => {
  resetState();
  // Reset scroll position after state reset
  scrollOffset = 56;
  applyScroll();
});

imgCol.parentElement.addEventListener('wheel', e => {
  e.preventDefault();
  clearHover();
  scrollOffset += e.deltaY;
  applyScroll();
}, { passive: false });

// Touch scroll
let touchY = 0;
imgCol.parentElement.addEventListener('touchstart', e => { touchY = e.touches[0].clientY; }, { passive: true });
imgCol.parentElement.addEventListener('touchmove', e => {
  clearHover();
  scrollOffset += touchY - e.touches[0].clientY;
  touchY = e.touches[0].clientY;
  applyScroll();
  e.preventDefault();
}, { passive: false });
</script>

<style>
/* ── ROOT GRID ───────────────────────────────────── */
#root {
  display: grid;
  height: 100vh;
}

#root[data-state="default"],
#root[data-state="closing"] {
  grid-template-columns: minmax(190px, 20%) 10% auto;
  transition: grid-template-columns 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

#root[data-state="detail"] {
  grid-template-columns: minmax(190px, 20%) 5% auto;
  transition: grid-template-columns 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ── LEFT ────────────────────────────────────────── */
#left {
  position: relative;
  height: 100vh;
  display: flex;
  align-items: center;
  padding: 0 0 0 var(--spacing-9xl);
}


/* ── IMAGE COLUMN ────────────────────────────────── */
#img-col {
  overflow: visible;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-base);
  will-change: transform;
}

.proj-item {
  cursor: pointer;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  transition: padding 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

#root[data-state="default"] .proj-item.is-hovered {
  padding: var(--spacing-15xl) 0;
  z-index: 10;
}

/* Last item: only bottom padding so the image doesn't get pushed DOWN */
#root[data-state="default"] .proj-item:last-child.is-hovered {
  padding: 0 0 var(--spacing-15xl) 0;
}



#root[data-state="default"] .proj-item.is-hovered img {
  transform: scale(1.3);
}

.proj-item img {
  width: 100%;
  height: auto;
  display: block;
  transform-origin: center center;
  transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 0.25s ease;
}


.proj-item.is-hovered { opacity: var(--opacity-active); }

.proj-item.is-selected {
  opacity: var(--opacity-full);
}

/* Remove all outlines from interactive elements */
.proj-item,
.proj-item:focus,
.proj-item:active,
#close-btn,
#close-btn:focus,
#close-btn:active,
.home-nav-link,
.home-nav-link:focus,
.home-nav-link:active {
  outline: none;
}

/* ── RIGHT ───────────────────────────────────────── */
#right {
  position: relative;
  height: 100vh;
}

/* ── HOVER TEXT ──────────────────────────────────── */
#hover-text {
  position: fixed;
  top: 0;
  left: 0;
  width: auto;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
  display: flex;
  flex-direction: column;
  gap: 0;
  z-index: 2;
}


#hover-text.visible { opacity: var(--opacity-full); }

#root[data-state="detail"] #hover-text,
#root[data-state="closing"] #hover-text { display: none; }

#ht-title {
  font-size: var(--font-size-sm);
  font-weight: 400;
  color: #000000;
  margin: 0 0 2px;
  line-height: 1.4;
  font-family: var(--font-sans);
}

#ht-credits {
  font-size: var(--font-size-xs);
  color: var(--color-brown);
  opacity: var(--opacity-default);
  margin: 0;
  line-height: 1.4;
  font-family: var(--font-sans);
}

#ht-desc {
  font-size: var(--font-size-xs);
  color: var(--color-brown);
  opacity: var(--opacity-default);
  margin: 0;
  line-height: 1.4;
  font-family: var(--font-sans);
}


/* ── SELECTED IMAGE ──────────────────────────────── */
#selected-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  padding: var(--spacing-5xl) var(--spacing-3xl);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.45s ease;
}

#root[data-state="detail"] #selected-img {
  opacity: var(--opacity-full);
  pointer-events: auto;
}

/* ── CLOSE BTN ───────────────────────────────────── */
#close-btn {
  position: fixed;
  top: var(--spacing-2xl);
  right: var(--spacing-5xl);
  background: none;
  border: none;
  font-size: var(--font-size-md);
  letter-spacing: var(--letter-spacing-normal);
  text-transform: uppercase;
  color: var(--color-brown);
  cursor: pointer;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
  z-index: 200;
  padding: 0;
  font-family: var(--font-sans);
}

#close-btn:hover { opacity: var(--opacity-strong) !important; }

#root[data-state="detail"] #close-btn {
  opacity: var(--opacity-muted);
  pointer-events: auto;
}

#root[data-state="closing"] #close-btn,
#root[data-state="default"] #close-btn {
  opacity: 0;
  pointer-events: none;
}

/* ── HOME NAV ────────────────────────────────────── */
#home-nav {
  position: fixed;
  top: var(--spacing-2xl);
  right: var(--spacing-5xl);
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: var(--spacing-base);
  z-index: 100;
  pointer-events: auto;
}

.home-nav-link {
  font-family: var(--font-sans);
  font-size: var(--font-size-md);
  letter-spacing: var(--letter-spacing-normal);
  text-transform: uppercase;
  text-decoration: none;
  color: var(--color-brown);
  opacity: var(--opacity-muted);
  transition: opacity 0.2s;
  white-space: nowrap;
}

.home-nav-link:hover { opacity: var(--opacity-prominent); }

#root[data-state="detail"] ~ #home-nav { display: none; }

/* ── MOBILE STYLES ──────────────────────────────────── */
@media (max-width: 768px) {
  /* Make images smaller and move them right by 10% */
  #root[data-state="default"],
  #root[data-state="closing"],
  #root[data-state="detail"] {
    grid-template-columns: minmax(0, 0) 120px 1fr;
  }

  #left {
    padding: 0;
  }

  #img-col {
    transform: translateX(10%);
    padding-left: var(--spacing-5xl);
  }

  /* Hide close button immediately on mobile to prevent overlap */
  #close-btn {
    transition: opacity 0s;
  }

  #root[data-state="closing"] #close-btn,
  #root[data-state="default"] #close-btn {
    display: none;
  }
}

</style>
