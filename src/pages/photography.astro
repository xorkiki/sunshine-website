---
import Base from '../layouts/Base.astro';
import { sanityClient } from '../lib/sanity';

let projects: any[] = [];
let clients: string[] = [];

try {
  projects = await sanityClient.fetch(`
    *[_type == "portfolioItem" && "photography" in category] | order(_createdAt desc) {
      _id, title, description, "slug": slug.current,
      "coverUrl": coverImage.asset->url,
      "images": images[].asset->url
    }
  `);
  console.log('[photography] Sanity returned', projects.length, 'items');
} catch (e: any) {
  console.error('[photography] Sanity fetch failed:', e?.message);
}

try {
  const about = await sanityClient.fetch(`*[_type == "aboutPage"][0] { clients }`);
  clients = about?.clients || [];
} catch (e) {}

const projectsJson = JSON.stringify(projects);
const PAGE_NAME = 'Sunzhique';
---

<Base title="Photography" description="Photography by Sunzhique" verticalName={true} hideNavLinks={true}>
<div id="root" data-state="default">

  <!-- ── GRID VIEW ─────────────────────────────────── -->
  <div id="grid-view">

    <!-- image grid (scrollable) -->
    <div id="grid-scroll">
      <div id="grid">
        {projects.map((p, i) => (
          <div
            class="proj-item"
            data-index={String(i)}
            data-title={p.title}
            data-desc={p.description || ''}
          >
            <div class="proj-img-wrap">
              <img src={p.coverUrl} alt={p.title} loading={i < 12 ? 'eager' : 'lazy'} decoding="async" />
            </div>
            <div class="proj-info">
              <p class="proj-title">{p.title}</p>
              {p.description && <p class="proj-desc">{p.description}</p>}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- right sidebar (sticky) -->
    <aside id="sidebar">
      <nav id="side-nav">
        <a href="/styling" class="side-link">Styling</a>
        <a href="/photography" class="side-link active">Photography</a>
        <a href="/about" class="side-link">About</a>
      </nav>

      {clients.length > 0 && (
        <div id="clients-block">
          <p class="clients-label">Clients</p>
          {clients.map((c: string) => <p class="client-name">{c}</p>)}
        </div>
      )}
    </aside>

  </div>

  <!-- ── DETAIL VIEW (overlay) ─────────────────────── -->
  <div id="detail-view">
    <div id="thumb-col"></div>
    <div id="detail-right">
      <img id="selected-img" src="" alt="" />
    </div>
  </div>

  <button id="close-btn">Close</button>

</div>
</Base>

<script define:vars={{ projectsJson }}>
const projects = JSON.parse(projectsJson);

const root        = document.getElementById('root');
const gridScroll  = document.getElementById('grid-scroll');
const grid        = document.getElementById('grid');
const thumbCol    = document.getElementById('thumb-col');
const selectedImg = document.getElementById('selected-img');
const closeBtn    = document.getElementById('close-btn');
const navLinks    = document.querySelector('.nav-links');

// ── PRELOAD IMAGE ──────────────────────────────────────
function preloadImage(url) {
  const link = document.createElement('link');
  link.rel = 'preload';
  link.as = 'image';
  link.href = url;
  document.head.appendChild(link);
  return link;
}

// ── CLICK (grid → detail) ──────────────────────────────
const gridContainer = grid || gridScroll;
gridContainer.addEventListener('click', e => {
  // Don't handle clicks if already in detail view
  if (root.dataset.state === 'detail') return;
  
  const item = e.target.closest('.proj-item');
  if (!item) return;

  const pi = parseInt(item.dataset.index);
  const project = projects[pi];
  const images = project.images?.length ? project.images : [project.coverUrl];

  // Preload all images in the project
  images.forEach(url => preloadImage(url));

  thumbCol.innerHTML = '';
  images.forEach((url, i) => {
    const div = document.createElement('div');
    div.className = 'thumb-item' + (i === 0 ? ' is-selected' : '');
    div.innerHTML = `<img src="${url}" loading="lazy" decoding="async" alt="" />`;
    div.addEventListener('click', () => {
      thumbCol.querySelectorAll('.thumb-item').forEach(t => t.classList.remove('is-selected'));
      div.classList.add('is-selected');
      preloadImage(url);
      selectedImg.src = url;
      selectedImg.loading = 'eager';
    });
    thumbCol.appendChild(div);
  });

  selectedImg.alt = project.title;
  selectedImg.loading = 'eager';
  selectedImg.src = images[0];
  
  root.dataset.state = 'detail';
  if (navLinks) { navLinks.style.opacity = '0'; navLinks.style.pointerEvents = 'none'; }
});

// ── CLOSE ──────────────────────────────────────────────
function closeDetail() {
  root.dataset.state = 'default';
  thumbCol.innerHTML = '';
  if (navLinks) { navLinks.style.opacity = ''; navLinks.style.pointerEvents = ''; }
}

closeBtn.addEventListener('click', closeDetail);
</script>

<style>
/* ── ROOT ────────────────────────────────────────── */
#root { height: 100%; position: relative; }

/* ── GRID VIEW ───────────────────────────────────── */
#grid-view {
  display: grid;
  grid-template-columns: 1fr 140px;
  height: 100vh;
}

/* ── SCROLLABLE GRID AREA ────────────────────────── */
#grid-scroll {
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: none;
  padding: var(--spacing-15xl) var(--spacing-9xl) var(--spacing-16xl) var(--spacing-14xl);
}

#grid-scroll::-webkit-scrollbar { display: none; }

#grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: var(--spacing-11xl) var(--spacing-2xl);
  align-items: end;
}

/* ── GRID ITEMS ──────────────────────────────────── */
.proj-item { cursor: pointer; }

.proj-img-wrap img {
  width: 100%;
  height: auto;
  display: block;
  transition: opacity 0.2s ease;
}

.proj-item:hover .proj-img-wrap img { opacity: var(--opacity-hover); }

.proj-info { margin-top: 5px; }

.proj-title {
  font-size: var(--font-size-sm);
  font-weight: 400;
  color: #000000;
  margin: 0 0 2px;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-family: var(--font-sans);
}

.proj-desc {
  font-size: var(--font-size-xs);
  color: var(--color-brown);
  opacity: var(--opacity-default);
  margin: 0;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-family: var(--font-sans);
}

/* ── RIGHT SIDEBAR ───────────────────────────────── */
#sidebar {
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-y: auto;
  scrollbar-width: none;
  padding: var(--spacing-2xl) var(--spacing-4xl) var(--spacing-7xl) var(--spacing-xl);
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: var(--spacing-6xl);
}

#sidebar::-webkit-scrollbar { display: none; }

#page-name-vert {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
}

.v-char {
  font-size: var(--font-size-md);
  letter-spacing: var(--letter-spacing-wider);
  color: var(--color-brown);
  opacity: var(--opacity-very-subtle);
  line-height: 1;
  font-family: var(--font-sans);
  font-weight: 400;
}

#side-nav {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: var(--spacing-base);
}

.side-link {
  font-size: var(--font-size-md);
  letter-spacing: var(--letter-spacing-normal);
  text-transform: uppercase;
  color: var(--color-brown);
  opacity: var(--opacity-muted);
  text-decoration: none;
  font-family: var(--font-sans);
  transition: opacity 0.2s;
  white-space: nowrap;
}

.side-link:hover { opacity: var(--opacity-prominent); }
.side-link.active { opacity: var(--opacity-prominent); }

#clients-block {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: var(--spacing-sm);
}

.clients-label {
  font-size: var(--font-size-sm);
  letter-spacing: var(--letter-spacing-wide);
  text-transform: uppercase;
  color: var(--color-brown);
  opacity: var(--opacity-subtle);
  margin: 0 0 var(--spacing-xs);
  font-family: var(--font-sans);
}

.client-name {
  font-size: var(--font-size-base);
  letter-spacing: var(--letter-spacing-tight);
  color: var(--color-brown);
  opacity: var(--opacity-medium);
  margin: 0;
  font-family: var(--font-sans);
  line-height: 1.5;
  text-align: right;
}

/* ── DETAIL VIEW (fixed overlay) ─────────────────── */
#detail-view {
  display: none;
  position: fixed;
  inset: 0;
  background: var(--color-cream);
  z-index: 50;
}

#root[data-state="detail"] #detail-view {
  display: grid;
  grid-template-columns: 14% 86%;
}

#thumb-col {
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: none;
  padding: var(--spacing-12xl) var(--spacing-lg) var(--spacing-12xl);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

#thumb-col::-webkit-scrollbar { display: none; }

.thumb-item {
  cursor: pointer;
  opacity: var(--opacity-soft);
  transition: opacity 0.2s ease;
  flex-shrink: 0;
}

.thumb-item:hover { opacity: var(--opacity-active); }

.thumb-item.is-selected {
  opacity: var(--opacity-full);
  outline: 1.5px solid var(--color-rust);
  outline-offset: -1px;
}

.thumb-item img { width: 100%; height: auto; display: block; }

#detail-right { position: relative; overflow: hidden; }

#selected-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  padding: var(--spacing-7xl) var(--spacing-7xl) var(--spacing-7xl) var(--spacing-3xl);
  image-rendering: -webkit-optimize-contrast;
  image-rendering: auto;
}

/* ── CLOSE BTN ───────────────────────────────────── */
#close-btn {
  position: fixed;
  top: var(--spacing-2xl);
  right: var(--spacing-5xl);
  background: none;
  border: none;
  font-size: var(--font-size-lg);
  letter-spacing: var(--letter-spacing-wide);
  text-transform: uppercase;
  color: var(--color-brown);
  cursor: pointer;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
  z-index: 200;
  padding: 0;
  font-family: var(--font-sans);
}

#close-btn:hover { opacity: var(--opacity-strong) !important; }

#root[data-state="detail"] #close-btn {
  opacity: var(--opacity-muted);
  pointer-events: auto;
}

/* ── RESPONSIVE ──────────────────────────────────── */
@media (max-width: 1280px) {
  #grid { grid-template-columns: repeat(6, 1fr); gap: var(--spacing-10xl) var(--spacing-2xl); }
}

@media (max-width: 1024px) {
  #grid { grid-template-columns: repeat(5, 1fr); gap: var(--spacing-8xl) var(--spacing-lg); }
  #grid-scroll { padding: var(--spacing-14xl) var(--spacing-6xl) var(--spacing-15xl) var(--spacing-9xl); }
  #sidebar { padding: var(--spacing-14xl) var(--spacing-2xl) var(--spacing-5xl) var(--spacing-lg); }
}

@media (max-width: 768px) {
  #grid-view { grid-template-columns: 1fr; }
  #sidebar { display: none; }
  #grid { grid-template-columns: repeat(3, 1fr); gap: var(--spacing-6xl) var(--spacing-base); }
  #grid-scroll { padding: var(--spacing-13xl) var(--spacing-3xl) var(--spacing-11xl); }
}

@media (max-width: 480px) {
  #grid { grid-template-columns: repeat(2, 1fr); gap: var(--spacing-3xl) var(--spacing-lg); }
  #grid-scroll { padding: var(--spacing-11xl) var(--spacing-xl) var(--spacing-9xl); }
  #root[data-state="detail"] #detail-view { grid-template-columns: 28% 72%; }
}
</style>
