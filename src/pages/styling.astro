---
import Base from '../layouts/Base.astro';
import { sanityClient } from '../lib/sanity';

let projects: any[] = [];
let clients: string[] = [];

try {
  projects = await sanityClient.fetch(`
    *[_type == "portfolioItem" && "styling" in category] | order(_createdAt desc) {
      _id, title, description, "slug": slug.current,
      "coverUrl": coverImage.asset->url,
      "images": images[].asset->url
    }
  `);
  console.log('[styling] Sanity returned', projects.length, 'items');
} catch (e: any) {
  console.error('[styling] Sanity fetch failed:', e?.message);
}

try {
  const about = await sanityClient.fetch(`*[_type == "aboutPage"][0] { clients }`);
  clients = about?.clients || [];
} catch (e) {}

const projectsJson = JSON.stringify(projects);
const PAGE_NAME = 'Sunzhique';
---

<Base title="Styling" description="Styling by Sunzhique" verticalName={true} hideNavLinks={true}>
<div id="root" data-state="default">

  <!-- ── GRID VIEW ─────────────────────────────────── -->
  <div id="grid-view">

    <!-- image grid (scrollable) -->
    <div id="grid-scroll">
      <div id="grid">
        {projects.map((p, i) => (
          <div
            class="proj-item"
            data-index={String(i)}
            data-title={p.title}
            data-desc={p.description || ''}
          >
            <div class="proj-img-wrap">
              <img src={p.coverUrl} alt={p.title} loading={i < 12 ? 'eager' : 'lazy'} decoding="async" />
            </div>
            <div class="proj-info">
              <p class="proj-title">{p.title}</p>
              {p.description && <p class="proj-desc">{p.description}</p>}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- right sidebar (sticky) -->
    <aside id="sidebar">
      <nav id="side-nav">
        <a href="/styling" class="side-link active">Styling</a>
        <a href="/photography" class="side-link">Photography</a>
        <a href="/about" class="side-link">About</a>
      </nav>

      {clients.length > 0 && (
        <div id="clients-block">
          <p class="clients-label">Clients</p>
          <p>&nbsp;</p>
          {clients.map((c: string) => <p class="client-name">{c}</p>)}
        </div>
      )}
    </aside>

  </div>

  <!-- ── DETAIL VIEW (overlay) ─────────────────────── -->
  <div id="detail-view">
    <div id="thumb-col"></div>
    <div id="detail-right">
      <img id="selected-img" src="" alt="" />
    </div>
  </div>

  <button id="close-btn">Close</button>

</div>
</Base>

<script define:vars={{ projectsJson }}>
const projects = JSON.parse(projectsJson);

const root        = document.getElementById('root');
const gridScroll  = document.getElementById('grid-scroll');
const thumbCol    = document.getElementById('thumb-col');
const selectedImg = document.getElementById('selected-img');
const closeBtn    = document.getElementById('close-btn');
const navLinks    = document.querySelector('.nav-links');

// ── CLICK (grid → detail) ──────────────────────────────
gridScroll.addEventListener('click', e => {
  const item = e.target.closest('.proj-item');
  if (!item) return;

  const pi = parseInt(item.dataset.index);
  const project = projects[pi];
  const images = project.images?.length ? project.images : [project.coverUrl];

  thumbCol.innerHTML = '';
  images.forEach((url, i) => {
    const div = document.createElement('div');
    div.className = 'thumb-item' + (i === 0 ? ' is-selected' : '');
    div.innerHTML = `<img src="${url}" loading="lazy" decoding="async" alt="" />`;
    div.addEventListener('click', () => {
      thumbCol.querySelectorAll('.thumb-item').forEach(t => t.classList.remove('is-selected'));
      div.classList.add('is-selected');
      selectedImg.src = url;
    });
    thumbCol.appendChild(div);
  });

  selectedImg.src = images[0];
  selectedImg.alt = project.title;

  root.dataset.state = 'detail';
  if (navLinks) { navLinks.style.opacity = '0'; navLinks.style.pointerEvents = 'none'; }
});

// ── CLOSE ──────────────────────────────────────────────
function closeDetail() {
  root.dataset.state = 'default';
  thumbCol.innerHTML = '';
  if (navLinks) { navLinks.style.opacity = ''; navLinks.style.pointerEvents = ''; }
}

closeBtn.addEventListener('click', closeDetail);
</script>

<style>
/* ── ROOT ────────────────────────────────────────── */
#root { height: 100%; position: relative; }

/* ── GRID VIEW ───────────────────────────────────── */
#grid-view {
  display: grid;
  grid-template-columns: 1fr 140px;
  height: 100vh;
  overflow: hidden;
}

/* ── SCROLLABLE GRID AREA ────────────────────────── */
#grid-scroll {
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: none;
  padding: 80px 24px 100px 72px;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  min-width: 0;
}

#grid-scroll::-webkit-scrollbar { display: none; }

#grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 60px 22px;
  align-items: end;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  min-width: 0;
  contain: layout;
}

/* ── GRID ITEMS ──────────────────────────────────── */
.proj-item { 
  cursor: pointer;
  min-width: 0;
}

.proj-img-wrap img {
  width: 100%;
  height: auto;
  display: block;
  transition: opacity 0.2s ease;
}

.proj-item:hover .proj-img-wrap img { opacity: 0.72; }

.proj-info { margin-top: 5px; }

.proj-title {
  font-size: 0.54rem;
  font-weight: 400;
  color: #301d10;
  margin: 0 0 2px;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.proj-desc {
  font-size: 0.5rem;
  color: #301d10;
  opacity: 0.45;
  margin: 0;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ── RIGHT SIDEBAR ───────────────────────────────── */
#sidebar {
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: none;
  padding: 20px 28px 40px 16px;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 36px;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  min-width: 0;
}

#sidebar::-webkit-scrollbar { display: none; }

/* vertical page name */
#page-name-vert {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
}

.v-char {
  font-size: 0.62rem;
  letter-spacing: 0.18em;
  color: #301d10;
  opacity: 0.35;
  line-height: 1;
  font-family: ui-sans-serif, system-ui, sans-serif;
  font-weight: 400;
}

/* side nav */
#side-nav {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10px;
}

.side-link {
  font-size: 0.62rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #301d10;
  opacity: 0.4;
  text-decoration: none;
  font-family: ui-sans-serif, system-ui, sans-serif;
  transition: opacity 0.2s;
  white-space: nowrap;
  overflow-wrap: break-word;
  max-width: 100%;
}

.side-link:hover { opacity: 0.9; }
.side-link.active { opacity: 0.9; }

/* clients */
#clients-block {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6px;
  margin-top: calc(28vh - 200px);
}

.clients-label {
  font-size: var(--font-size-xs);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #301d10;
  opacity: 0.3;
  margin: 0 0 4px;
  font-family: ui-sans-serif, system-ui, sans-serif;
}

.client-name {
  font-size: var(--font-size-xs);
  letter-spacing: 0.08em;
  color: #301d10;
  opacity: 0.5;
  margin: 0;
  font-family: ui-sans-serif, system-ui, sans-serif;
  line-height: 1.5;
  text-align: right;
}

/* ── DETAIL VIEW (fixed overlay) ─────────────────── */
#detail-view {
  display: none;
  position: fixed;
  inset: 0;
  background: #f8f4f1;
  z-index: 50;
}

#root[data-state="detail"] #detail-view {
  display: grid;
  grid-template-columns: 14% 86%;
}

#thumb-col {
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: none;
  padding: 64px 12px 64px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

#thumb-col::-webkit-scrollbar { display: none; }

.thumb-item {
  cursor: pointer;
  opacity: 0.55;
  transition: opacity 0.2s ease;
  flex-shrink: 0;
}

.thumb-item:hover { opacity: 0.8; }

.thumb-item.is-selected {
  opacity: 1;
  outline: 1.5px solid #a34a21;
  outline-offset: -1px;
}

.thumb-item img { width: 100%; height: auto; display: block; }

#detail-right { position: relative; overflow: hidden; }

#selected-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  padding: 40px 40px 40px 24px;
}

/* ── CLOSE BTN ───────────────────────────────────── */
#close-btn {
  position: fixed;
  top: 20px;
  right: 32px;
  background: none;
  border: none;
  font-size: 0.65rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #301d10;
  cursor: pointer;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
  z-index: 200;
  padding: 0;
}

#close-btn:hover { opacity: 0.65 !important; }

#root[data-state="detail"] #close-btn {
  opacity: 0.4;
  pointer-events: auto;
}

/* ── RESPONSIVE ──────────────────────────────────── */
@media (max-width: 1280px) {
  #grid-view { grid-template-columns: 1fr 130px; }
  #grid { grid-template-columns: repeat(6, 1fr); gap: 52px 20px; }
}

@media (max-width: 1024px) {
  #grid-view { grid-template-columns: 1fr 120px; }
  #grid { grid-template-columns: repeat(5, 1fr); gap: 44px 18px; }
  #grid-scroll { padding: 72px 20px 80px 48px; }
  #sidebar { padding: 72px 20px 32px 12px; }
}

@media (max-width: 768px) {
  #grid-view { grid-template-columns: 1fr 100px; }
  #grid { grid-template-columns: repeat(4, 1fr); gap: 24px 12px; }
  #grid-scroll { padding: 68px 12px 60px 50px; }
  #sidebar { padding: 68px 12px 32px 8px; gap: 24px; }
}

@media (max-width: 480px) {
  #grid-view { grid-template-columns: 1fr 80px; }
  #grid { grid-template-columns: repeat(3, 1fr); gap: 20px 10px; }
  #grid-scroll { padding: 80px 8px 48px 40px; }
  #sidebar { padding: 80px 8px 32px 4px; gap: 20px; }
  #side-nav { gap: 8px; }
  .side-link { font-size: 0.55rem; }
  #root[data-state="detail"] #detail-view { grid-template-columns: 28% 72%; }
}
</style>
