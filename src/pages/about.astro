---
import Base from '../layouts/Base.astro';
import { sanityClient } from '../lib/sanity';

let about: any = null;
try {
  about = await sanityClient.fetch(`
    *[_type == "aboutPage"][0] {
      name, bio, clients,
      "headshotUrl": headshot.asset->url,
    }
  `);
} catch (e) {}

const headshotUrl = about?.headshotUrl || '/images/portrait.jpg';
const clients: string[] = about?.clients || ['DKNY', 'COACH', 'NIKE', 'HELMUT LANG', 'JOHN ELLIOTT'];
const bio = about?.bio || 'PHOTOGRAPHER AND VISUAL ARTIST BASED IN NYC';
---

<Base title="About" description="About Sunzhique">
<div id="about-page">

  <!-- TOP LEFT: descriptor -->
  <div id="descriptor">
    FASHION STYLIST AND CREATIVE<br/>
    DIRECTOR BASED IN NEW YORK<br/>
    ORIGINALLY FROM KAZAKHSTAN
  </div>

  <!-- TOP RIGHT: quote -->
  <div id="quote-block">
    <p class="clients-label">CLIENTS</p>
    <p>&nbsp;</p>
    {clients.map((c: string) => <p class="client-name">{c.toUpperCase()}</p>)}
  </div>

  <!-- MID LEFT: links -->
  <div id="links-block">
    <a href="https://instagram.com" target="_blank" rel="noreferrer" class="about-link">INSTAGRAM</a>
    <a href="mailto:contactsunzhique@gmail.com" class="about-link">EMAIL</a>
    <a href="/" class="about-link">PORTFOLIO</a>
  </div>

  <!-- PORTRAIT -->
  <div id="portrait">
    <img src={headshotUrl} alt="Sunzhique" />
  </div>

  <!-- BOTTOM BAR -->
  <div id="bottom-bar">
    <span>2026</span>
    <span>DJ</span>
    <span>STYLIST</span>
    <span>PHOTOGRAPHER</span>
  </div>

</div>
</Base>

<style>
  #about-page {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    background-color: var(--color-cream);
  }

  /* ── DESCRIPTOR ──────────────────────────── */
  #descriptor {
    position: absolute;
    top: var(--spacing-13xl);
    left: var(--spacing-5xl);
    width: 210px;
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-tight);
    line-height: 1.4;
    color: var(--color-brown);
    opacity: var(--opacity-strong);
    text-align: justify;
    text-align-last: justify;
  }

  /* ── QUOTE ────────────────────────────────── */
  #quote-block {
    position: absolute;
    top: 28%;
    right: var(--spacing-5xl);
    text-align: right;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  #quote-block p {
    margin: 0;
    font-family: var(--font-sans);
  }

  .clients-label {
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-brown);
    opacity: var(--opacity-subtle);
    margin: 0 0 var(--spacing-xs);
    font-family: var(--font-sans);
  }

  .client-name {
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-brown);
    opacity: var(--opacity-medium);
    margin: 0;
    font-family: var(--font-sans);
    line-height: 1.5;
    text-align: right;
  }

  /* ── LINKS ────────────────────────────────── */
  #links-block {
    position: absolute;
    top: 55%;
    left: var(--spacing-5xl);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-base);
  }

  .about-link {
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-normal);
    text-transform: uppercase;
    color: var(--color-brown);
    opacity: var(--opacity-muted);
    text-decoration: none;
    font-family: var(--font-sans);
    transition: opacity 0.2s;
    display: block;
    white-space: nowrap;
  }

  .about-link:hover { opacity: var(--opacity-prominent); }
  .about-link.active { opacity: var(--opacity-prominent); }

  /* ── PORTRAIT ─────────────────────────────── */
  #portrait {
    position: absolute;
    top: 48%;
    left: 57%;
    width: 13vw;
    min-width: 120px;
    max-width: 180px;
  }

  #portrait img {
    width: 100%;
    height: auto;
    display: block;
    filter: grayscale(20%);
  }

  /* ── BOTTOM BAR ───────────────────────────── */
  #bottom-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: var(--spacing-8xl);
    display: flex;
    align-items: center;
    padding: 0 var(--spacing-5xl);
    gap: var(--spacing-xs);
    justify-content: space-between;
  }

  #bottom-bar span {
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-normal);
    color: var(--color-brown);
    opacity: var(--opacity-medium);
    font-family: var(--font-sans);
  }

</style>
