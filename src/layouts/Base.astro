---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

export interface Props {
  title?: string;
  description?: string;
  hideName?: boolean;
  verticalName?: boolean;
  hideNavLinks?: boolean;
}

const { title = 'Sunzhique', description = 'Photography & Portfolio', hideName = false, verticalName = false, hideNavLinks = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — Sunzhique</title>
    <ClientRouter />
    <meta property="og:title" content={`${title} — Sunzhique`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-image.svg" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="/og-image.svg" />
  </head>
  <body>

    <nav id="site-nav">
      {!hideName && (
        <a href="/" class={`nav-name${verticalName ? ' nav-name-vertical' : ''}`}>Sunzhique</a>
      )}
      {hideName && <span class="nav-name-placeholder" />}

      {!hideNavLinks && (
        <div class="nav-links">
          <a href="/styling" class={`nav-link ${currentPath === '/styling' ? 'active' : ''}`}>Styling</a>
          <a href="/photography" class={`nav-link ${currentPath === '/photography' ? 'active' : ''}`}>Photography</a>
          <a href="/about" class={`nav-link ${currentPath === '/about' ? 'active' : ''}`}>About</a>
        </div>
      )}
    </nav>

    <main>
      <slot />
    </main>

  </body>
</html>

<style>
  body {
    background-color: var(--color-cream);
    color: var(--color-brown);
    margin: 0;
    overflow: hidden;
    height: 100vh;
  }

  main {
    height: 100vh;
    overflow: hidden;
  }

  /* ── NAV ─────────────────────────────────────── */
  #site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: var(--spacing-2xl) var(--spacing-5xl);
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
  }

  .nav-name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--font-size-3xl);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-brown);
    pointer-events: auto;
    white-space: nowrap;
  }

  .nav-name-vertical {
    writing-mode: vertical-lr;
    text-orientation: upright;
    position: fixed;
    left: var(--spacing-5xl);
    top: var(--spacing-2xl);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-brown);
    pointer-events: auto;
  }

  .nav-name-placeholder {
    display: block;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--spacing-6xl);
    pointer-events: auto;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: var(--font-size-md);
    letter-spacing: var(--letter-spacing-normal);
    text-transform: uppercase;
    text-decoration: none;
    font-weight: 400;
    color: var(--color-brown);
    opacity: var(--opacity-muted);
    white-space: nowrap;
    transition: opacity 0.2s;
  }

  .nav-link:hover { opacity: var(--opacity-prominent); }
  .nav-link.active { opacity: var(--opacity-prominent); }

  /* ── RESPONSIVE ──────────────────────────────── */

  @media (max-width: 720px) and (min-width: 541px) {
    .nav-links { gap: var(--spacing-2xl); }
    .nav-link { font-size: var(--font-size-md); }
  }

  @media (max-width: 540px) {
    #site-nav { align-items: flex-start; }
    .nav-links {
      flex-direction: column;
      align-items: flex-end;
      gap: var(--spacing-md);
    }
  }
</style>
