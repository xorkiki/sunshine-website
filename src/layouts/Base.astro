---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

export interface Props {
  title?: string;
  description?: string;
  hideName?: boolean;
  verticalName?: boolean;
  hideNavLinks?: boolean;
}

const { title = 'Sunzhique', description = 'Photography & Portfolio', hideName = false, verticalName = false, hideNavLinks = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — Sunzhique</title>
    <ClientRouter />
    <meta property="og:title" content={`${title} — Sunzhique`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-image.svg" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="/og-image.svg" />
  </head>
  <body>

    <nav id="site-nav">
      {!hideName && (
        <a href="/" class={`nav-name${verticalName ? ' nav-name-vertical' : ''}`}>Sunzhique</a>
      )}
      {hideName && <span class="nav-name-placeholder" />}

      {!hideNavLinks && (
        <div class="nav-links">
          <a href="/styling" class={`nav-link ${currentPath === '/styling' ? 'active' : ''}`}>Styling</a>
          <a href="/photography" class={`nav-link ${currentPath === '/photography' ? 'active' : ''}`}>Photography</a>
          <a href="/about" class={`nav-link ${currentPath === '/about' ? 'active' : ''}`}>About</a>
        </div>
      )}
    </nav>

    <main>
      <slot />
    </main>

  </body>
</html>

<script>
</script>

<style>
  body {
    background-color: #f8f4f1;
    color: #301d10;
    margin: 0;
    overflow: hidden;
    height: 100vh;
  }

  main {
    height: 100vh;
    overflow: hidden;
  }

  /* ── NAV ─────────────────────────────────────── */
  #site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 32px;
    padding-right: 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
    background-color: transparent;
  }

  .nav-name {
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: #301d10;
    pointer-events: auto;
    white-space: nowrap;
    line-height: 1;
  }

  .nav-name-vertical {
    writing-mode: vertical-lr;
    text-orientation: upright;
    position: fixed;
    left: 28px;
    top: 20px;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: #301d10;
    pointer-events: auto;
    z-index: 100;
    line-height: 1;
  }

  .nav-name-placeholder {
    display: block;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 36px;
    pointer-events: auto;
    position: relative;
  }

  .nav-link {
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    font-weight: 400;
    color: #301d10;
    opacity: 0.4;
    white-space: nowrap;
    transition: opacity 0.2s;
  }

  .nav-link:hover { opacity: 0.9; }
  .nav-link.active { opacity: 0.9; }

  /* ── RESPONSIVE ──────────────────────────────── */

  @media (max-width: 1280px) {
    .nav-name-vertical { 
      font-size: 0.75rem;
      left: 28px;
    }
  }

  @media (max-width: 1024px) {
    .nav-name { font-size: 0.95rem; }
    .nav-name-vertical { 
      font-size: 0.72rem;
      left: 20px;
    }
    .nav-link { font-size: 0.58rem; }
  }

  @media (max-width: 768px) {
    .nav-name { font-size: 0.85rem; }
    .nav-name-vertical { 
      font-size: 0.70rem;
      left: 12px;
    }
    .nav-link { font-size: 0.55rem; }
  }

  @media (max-width: 720px) and (min-width: 541px) {
    .nav-links { gap: 20px; }
    .nav-name { font-size: 0.82rem; }
    .nav-name-vertical { 
      font-size: 0.68rem;
      left: 12px;
    }
    .nav-link { font-size: 0.54rem; }
  }

  @media (max-width: 540px) {
    #site-nav {
      align-items: flex-start;
      padding-top: 12px;
      padding-bottom: 12px;
      padding-left: 16px;
      padding-right: 16px;
      background-color: transparent;
      box-sizing: border-box;
      width: 100%;
      left: 0;
      right: 0;
      min-height: auto;
    }
    .nav-links {
      flex-direction: column;
      align-items: flex-end;
      gap: 4px;
      margin: 0;
      padding: 0;
      flex-shrink: 0;
      align-self: flex-start;
    }
    .nav-name {
      font-size: 0.75rem;
      flex-shrink: 0;
      line-height: 1;
      margin: 0;
    }
    .nav-link {
      font-size: 0.48rem;
      line-height: 1.2;
      padding: 0;
      margin: 0;
      display: block;
    }
    .nav-name-vertical {
      font-size: 0.62rem;
      left: 8px;
    }
  }

  @media (max-width: 480px) {
    .nav-name-vertical { 
      font-size: 0.62rem;
      left: 8px;
    }
  }
</style>
